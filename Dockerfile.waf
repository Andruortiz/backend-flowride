FROM owasp/modsecurity-crs:nginx@sha256:697812147e7eada5c668e9728c6439d4663476c69f68635d24fb7878aac0f26a

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade libbrotli1 \
    && rm -rf /var/lib/apt/lists/*
RUN echo 'proxy_ssl_server_name on;' >> /etc/nginx/templates/includes/proxy_backend.conf.template
USER nginx

ENV BACKEND=http://localhost:8080 \
    PORT=8000 \
    NGINX_X_FORWARDED_PROTO=\$http_x_forwarded_proto \
    PARANOIA=1 \
    BLOCKING_PARANOIA=1 \
    MODSEC_RULE_ENGINE=on \
    MODSEC_RESP_BODY_ACCESS=off \
    MODSEC_REQ_BODY_LIMIT=1048576 \
    SERVER_TOKENS=off \
    SERVER_HEADER=

EXPOSE 8000
