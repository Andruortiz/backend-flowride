FROM owasp/modsecurity-crs:nginx@sha256:7698c48a41a43138ae317feeec964d1515b861cc1d9e50617bc1cdfe9f314e1d

USER root
RUN echo 'proxy_ssl_server_name on;' >> /etc/nginx/templates/includes/proxy_backend.conf.template
USER nginx

ENV BACKEND=http://localhost:8080 \
    PORT=8000 \
    NGINX_X_FORWARDED_PROTO=\$http_x_forwarded_proto \
    PARANOIA=1 \
    BLOCKING_PARANOIA=1 \
    MODSEC_RULE_ENGINE=on \
    MODSEC_RESP_BODY_ACCESS=off \
    MODSEC_REQ_BODY_LIMIT=1048576 \
    SERVER_TOKENS=off \
    SERVER_HEADER=

EXPOSE 8000
