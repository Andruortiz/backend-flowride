  <diagram id="pag1" name="Paquetes - importaciones entre modulos">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4920" pageHeight="6778" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="FlowRide.Inicializador — compone persistencia, seguridad web (JWT, políticas, tenant) y los 9 módulos con Registro.AgregarModulo…; migraciones y sembrado de desarrollo" style="shape=folder;fontStyle=1;tabWidth=190;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=22;container=1;collapsible=0;recursiveResize=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="4020" height="100" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Cómo leer el diagrama&lt;/b&gt;&lt;br&gt;Cada flecha va &lt;b&gt;de quien usa a lo usado&lt;/b&gt;, de un paquete exacto a otro paquete exacto, y dice qué tipos se importan.&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;- - →  «import» (gris): servicios, consultas, dtos o tipos de dominio de otro módulo&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#c0392b&quot;&gt;——→  «publica» / «escucha» (rojo): eventos a través de Contratos + outbox&lt;/font&gt;&lt;br&gt;Cajas de &lt;b&gt;arriba&lt;/b&gt; de cada módulo: Servicios, Repositorios y los puertos públicos (Entrada, Consulta, Dtos). Cajas de &lt;b&gt;abajo&lt;/b&gt;: Manejadores de eventos y Dominio.&lt;br&gt;Las flechas salen y llegan por arriba o por abajo del paquete, en carriles rectos independientes." style="rounded=0;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="4100" y="200" width="760" height="270" as="geometry"/></mxCell>
