        <mxCell id="-moaO_4h60-l3L9sqbmE-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6F6F6F;fillColor=#1C1C1C;fontColor=#E0E0E0;align=left;verticalAlign=top;spacing=10;rounded=0;fontSize=11;" value="Leyenda:&amp;nbsp;&lt;div&gt;persona (azul oscuro)&lt;/div&gt;&lt;div&gt;&amp;nbsp;·&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;contenedor (azul) ·&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;base de datos (cilindro)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;·&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;&amp;nbsp;sistema externo (gris)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(224, 224, 224), rgb(45, 45, 45));&quot;&gt;· límite (línea discontinua).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;El stack Silo se repite por operador; los componentes de plataforma no guardan datos operacionales. El registro de contenedores y el pipeline de despliegue se muestran en la vista de despliegue (ADR-0010).&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="990" x="790" y="1630" as="geometry" />
        </mxCell>
