{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Borde": {
    "MaxBytesCuerpo": 1048576,
    "LimitePorMinuto": 300,
    "AppSecret": "",
    "VerifyToken": "",
    "Operadores": []
  },
  "ReverseProxy": {
    "Routes": {
      "panel": {
        "ClusterId": "operador",
        "RateLimiterPolicy": "por-ip",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "operador": {
        "Destinations": {
          "stack": { "Address": "http://127.0.0.1:5072/" }
        }
      }
    }
  }
}
