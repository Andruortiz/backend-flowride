{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Outbox": {
    "Habilitado": true,
    "IntervaloSegundos": 2,
    "MaximoIntentos": 8
  },
  "Planificador": {
    "Habilitado": true,
    "IntervaloSegundos": 60
  },
  "Base": {
    "MigrarAlIniciar": false
  },

  "Jwt": {
    "Authority": "http://localhost:8080/realms/flowride",
    "Audience": "flowride-api"
  }
}
